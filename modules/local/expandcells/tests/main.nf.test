nextflow_process {

    name "Test Process EXPANDCELLS"
    script "../main.nf"
    process "EXPANDCELLS"

    tag "modules"
    tag "modules_local"
    tag "expandcells"

    test("expandcells - whole-cell only") {

        when {
            params {
                use_whole_cell_only    = true
                cell_expansion_microns = 1.5
                pixel_size_microns     = 0.5
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('${projectDir}/tests/data/mesmer/test_data_whole-cell.tiff', checkIfExists: true),
                    file('${projectDir}/tests/data/mesmer/test_data_whole-cell.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.mask[0][1].toString().endsWith('test_whole-cell_expanded.tiff') },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("expandcells - with nuclear mask") {

        when {
            params {
                use_whole_cell_only    = false
                cell_expansion_microns = 1.5
                pixel_size_microns     = 0.5
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('${projectDir}/tests/data/mesmer/test_data_nuclear.tiff', checkIfExists: true),
                    file('${projectDir}/tests/data/mesmer/test_data_whole-cell.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("expandcells - stub") {

        options "-stub"

        when {
            params {
                cell_expansion_microns = 1.5
            }
            process {
                """
                input[0] = [
                    [ id:'test_stub' ],
                    file('${projectDir}/tests/data/mesmer/test_data_whole-cell.tiff', checkIfExists: true),
                    file('${projectDir}/tests/data/mesmer/test_data_whole-cell.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
