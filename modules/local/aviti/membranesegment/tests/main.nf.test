nextflow_process {

    name "Test Process AVITIMEMBRANESEGMENT"
    script "../main.nf"
    process "AVITIMEMBRANESEGMENT"

    tag "modules"
    tag "modules_local"
    tag "aviti"
    tag "aviti_membranesegment"

    // Real (non-stub) execution requires a GPU + a real Cellpose 3.x
    // membrane model checkpoint, neither of which is available in this test
    // environment, so only the stub path is exercised here. The underlying
    // Python logic is covered independently by
    // tests/python/test_aviti_cellpose3_segment.py. model_path just needs to
    // exist on disk for staging -- its content is never read in stub mode --
    // so, like AVITINUCLEARSEGMENT's stub test, it reuses an existing tile
    // TIFF as a stand-in rather than requiring a real model file.
    test("aviti_membranesegment - stub, 3-channel") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test__WellA1__L1R01C01S1', tile:'L1R01C01S1', membrane_model:'test_model', cell_diameter:0 ], // meta map
                    file('${projectDir}/tests/data/aviti/Projection/WellA1/CP01_L1R01C01S1_Nucleus.tif', checkIfExists: true),
                    file('${projectDir}/tests/data/aviti/Projection/WellA1/CP01_L1R01C01S1_Cell-Membrane.tif', checkIfExists: true),
                    file('${projectDir}/tests/data/aviti/Projection/WellA1/CP01_L1R01C01S1_Actin.tif', checkIfExists: true),
                    file('${projectDir}/tests/data/aviti/Projection/WellA1/CP01_L1R01C02S1_Nucleus.tif', checkIfExists: true) // stand-in model_path
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("aviti_membranesegment - stub, 2-channel (no actin)") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test__WellA1__L1R01C02S1', tile:'L1R01C02S1', membrane_model:'test_model', cell_diameter:15 ], // meta map
                    file('${projectDir}/tests/data/aviti/Projection/WellA1/CP01_L1R01C02S1_Nucleus.tif', checkIfExists: true),
                    file('${projectDir}/tests/data/aviti/Projection/WellA1/CP01_L1R01C02S1_Cell-Membrane.tif', checkIfExists: true),
                    file('NO_FILE'),
                    file('${projectDir}/tests/data/aviti/Projection/WellA1/CP01_L1R01C01S1_Nucleus.tif', checkIfExists: true) // stand-in model_path
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
