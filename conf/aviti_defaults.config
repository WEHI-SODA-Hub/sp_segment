// AVITI-specific defaults. Pass this file with `-c conf/aviti_defaults.config`
// to override the pipeline's default AVITI values without editing
// nextflow.config.
//
// AVITI uses its own tuning namespace (`aviti_*`) rather than the
// COMET/MIBI `cellpose_*` values, because it runs different segmentation
// stacks (Cellpose v4 whole-cell, Cellpose 3.x nuclear/membrane) and the
// nuclear model is fixed per run while membrane model selection is per row.

params {
    pixel_size_microns                 = 0.25

    aviti_channel_mode                 = 'auto'
    aviti_cellpaint_batch              = 'CP01'
    aviti_models_dir                   = null
    aviti_nuclear_model                = '20250212_cellpose_nuc_8diam'
    aviti_wholecell_diameter           = 30
    aviti_membrane_diameter            = 0
    aviti_nuclear_diameter             = 0
    aviti_cellpose_flow_threshold      = 0.4
    aviti_cellpose_cellprob_threshold  = 0.0
    aviti_cellpose_min_area            = 200
    aviti_nuclear_min_area             = 0

    // Keep the v4 SAM path default consistent with the main pipeline.
    cellpose_pretrained_model          = 'cpsam_v2'
}
